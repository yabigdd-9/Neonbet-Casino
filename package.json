{
  "name": "neonbet-casino",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "secret-scan": "node scripts/secret-scan.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src server e2e scripts *.js *.json .github/workflows/*.yml",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run secret-scan && npm run build && npm run bundle:check",
    "bundle:check": "node scripts/bundle-report.mjs",
    "build:e2e": "vite build --base=/Neonbet-Casino/"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.5.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.0.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
