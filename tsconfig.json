{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "server/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
